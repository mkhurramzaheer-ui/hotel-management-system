@page "/Error"
@using System.Diagnostics

<PageTitle>Error – Hotel Admin</PageTitle>

<div style="max-width:500px;margin:80px auto;text-align:center;padding:0 24px">
    <div style="font-size:4rem">⚠️</div>
    <h2 style="font-family:'DM Serif Display',serif;color:#1a237e;margin:16px 0 8px">
        Something went wrong
    </h2>
    <p style="color:#546e7a">An error occurred while processing your request.</p>

    @if (ShowRequestId)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3 mb-4">
            Request ID: <code>@RequestId</code>
        </MudAlert>
    }

    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Class="ha-add-btn">
        Return to Dashboard
    </MudButton>
</div>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
