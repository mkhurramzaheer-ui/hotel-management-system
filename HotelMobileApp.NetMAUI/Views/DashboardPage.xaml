<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HotelMobileApp.NetMAUI.Views.DashboardPage"
             Title="Dashboard"
             BackgroundColor="#F6F1E9">
    <ScrollView>
        <VerticalStackLayout Padding="24,40,24,24" Spacing="18">
            <Label Text="Dashboard"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="#1F3A5F" />

            <Border BackgroundColor="White"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="0"
                    Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding WelcomeMessage}"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#1F3A5F" />

                    <Label Text="{Binding SummaryMessage}"
                           FontSize="15"
                           TextColor="#5A6872" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Logout"
                    Command="{Binding LogoutCommand}"
                    HeightRequest="48"
                    CornerRadius="14"
                    BackgroundColor="#B42318"
                    TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
