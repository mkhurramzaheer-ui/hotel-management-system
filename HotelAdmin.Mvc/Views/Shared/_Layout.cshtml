<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hotel Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
            body {
                overflow-x: hidden;
            }

            .sidebar {
                height: 100vh;
                background: #1e293b;
                color: white;
            }

                .sidebar a {
                    color: #cbd5e1;
                    text-decoration: none;
                    display: block;
                    padding: 12px;
                }

                    .sidebar a:hover {
                        background: #334155;
                        color: white;
                    }

            .topbar {
                background: #f8fafc;
                padding: 10px 20px;
                border-bottom: 1px solid #ddd;
            }
    </style>
</head>
<body>

    <div class="container-fluid">
        <div class="row">

            <!-- Sidebar -->
            <div class="col-md-2 sidebar p-3">
                <h4 class="text-center mb-4">Hotel Admin</h4>

                <a asp-controller="Dashboard" asp-action="Index">Dashboard</a>
                <a asp-controller="Rooms" asp-action="Index">Rooms</a>
                <a asp-controller="Customers" asp-action="Index">Customers</a>
                <a asp-controller="Bookings" asp-action="Index">Bookings</a>
                <a asp-controller="Billing" asp-action="Index">Billing</a>

                <hr />
                <a asp-controller="Account" asp-action="Logout">Logout</a>
            </div>

            <!-- Main Content -->
            <div class="col-md-10 p-0">

                <!-- Topbar -->
                <div class="topbar d-flex justify-content-between">
                    <h5>@ViewData["Title"]</h5>
                    <div>
                        <span>Welcome, Admin</span>
                    </div>
                </div>

                <!-- Page Content -->
                <div class="p-4">
                    @RenderBody()
                </div>

            </div>

        </div>
    </div>

</body>
</html>