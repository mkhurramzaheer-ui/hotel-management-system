@{
    Context.Session.Remove("SuccessMessage");
    Context.Session.Remove("ErrorMessage");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hotel Admin</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
            body {
                overflow-x: hidden;
            }

            .sidebar {
                height: 100vh;
                background: #1e293b;
                color: white;
            }

                .sidebar a {
                    color: #cbd5e1;
                    text-decoration: none;
                    display: block;
                    padding: 12px;
                }

                    .sidebar a:hover {
                        background: #334155;
                        color: white;
                    }

            .topbar {
                background: #f8fafc;
                padding: 10px 20px;
                border-bottom: 1px solid #ddd;
            }
    </style>
</head>
<body>
    <div class="position-fixed top-0 end-0 p-3" style="z-index: 9999">
        <div id="toastContainer"></div>
    </div>
    <div id="loader" style="display:none; position:fixed; z-index:9999; width:100%; height:100%; background:rgba(0,0,0,0.4);">
        <div class="d-flex justify-content-center align-items-center h-100">
            <div class="spinner-border text-light" style="width:3rem; height:3rem;"></div>
        </div>
    </div>
    <div class="container-fluid">
        <div class="row">

            <!-- Sidebar -->
            <div class="col-md-2 sidebar p-3">
                <h4 class="text-center mb-4">Hotel Admin</h4>

                <a asp-controller="Home" asp-action="Index">Dashboard</a>
                <a asp-controller="Rooms" asp-action="Index">Rooms</a>
                <a asp-controller="Customers" asp-action="Index">Customers</a>
                <a asp-controller="Bookings" asp-action="Index">Bookings</a>
                <a asp-controller="Billing" asp-action="Index">Billing</a>

                <hr />
                <a asp-controller="Account" asp-action="Logout">Logout</a>
            </div>

            <!-- Main Content -->
            <div class="col-md-10 p-0">

                <!-- Topbar -->
                <div class="topbar d-flex justify-content-between">
                    <h5>@ViewData["Title"]</h5>
                    <div>
                        <span>Welcome, Admin</span>
                    </div>
                </div>

                <!-- Page Content -->
                <div class="p-4">
                    @RenderBody()
                </div>

            </div>

        </div>
    </div>

</body>
</html>
<script>
    window.onload = function () {

        const success = '@Context.Session.GetString("SuccessMessage")';
        const error = '@Context.Session.GetString("ErrorMessage")';

        if (success) {
            showToast(success, "success");
        }

        if (error) {
            showToast(error, "danger");
        }
    };
    function showLoader() {
        document.getElementById("loader").style.display = "block";
    }

    function hideLoader() {
        document.getElementById("loader").style.display = "none";
    }

    // 🔥 Automatically trigger on form submit
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll("form").forEach(form => {
            form.addEventListener("submit", function () {
                showLoader();
            });
        });
    });
</script>